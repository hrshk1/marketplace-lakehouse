# Copy to .env (scripts/dev.py does this on first `up`). Every value here is a
# local development default; nothing in this file is a real secret.

# --- Source: PostgreSQL OLTP -------------------------------------------------
OLTP_PG_HOST=postgres-source
OLTP_PG_PORT=5432
OLTP_PG_DB=marketplace
OLTP_PG_USER=oltp
OLTP_PG_PASSWORD=oltp_local

# --- Source: MongoDB ----------------------------------------------------------
MONGO_URI=mongodb://mongo:27017
MONGO_DB=marketplace

# --- Object store (MinIO, S3 API) ---------------------------------------------
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=lakehouse
S3_SECRET_KEY=lakehouse_local
LAKE_BUCKET=lake
EXPORT_BUCKET=warehouse-exports

# --- Iceberg catalog ----------------------------------------------------------
# `jdbc` uses the Postgres-backed catalog; `hadoop` is a file-system catalog
# used by the test suite so it needs no running services.
ICEBERG_CATALOG_TYPE=jdbc
ICEBERG_CATALOG_URI=jdbc:postgresql://postgres-platform:5432/iceberg_catalog
ICEBERG_WAREHOUSE=s3a://lake/warehouse
EXPORT_ROOT=s3a://warehouse-exports/gold

# --- Platform Postgres (Iceberg catalog, dw, Airflow and Metabase metadata) ---
PLATFORM_PG_HOST=postgres-platform
PLATFORM_PG_PORT=5432
PLATFORM_PG_USER=platform
PLATFORM_PG_PASSWORD=platform_local
DW_PG_DB=warehouse

# --- Spark (local mode) -------------------------------------------------------
SPARK_DRIVER_MEMORY=1g
SPARK_SHUFFLE_PARTITIONS=4

# --- Data generator -----------------------------------------------------------
GENERATOR_SEED=42
SIM_START_DATE=2026-06-30
DEFECT_RATE=0.005
SCHEMA_DRIFT_DAY=2
LEDGER_PATH=/opt/project/data/generator_ledger.sqlite

# --- Extraction ---------------------------------------------------------------
EXTRACT_LOOKBACK_MINUTES=60

# --- Metabase -----------------------------------------------------------------
METABASE_URL=http://metabase:3000
METABASE_ADMIN_EMAIL=admin@marketplace.local
METABASE_ADMIN_PASSWORD=Lakehouse-local-1

# --- Host ports ---------------------------------------------------------------
HOST_PORT_OLTP_PG=5433
HOST_PORT_PLATFORM_PG=5434
HOST_PORT_MONGO=27018
HOST_PORT_MINIO_API=9000
HOST_PORT_MINIO_CONSOLE=9001
HOST_PORT_AIRFLOW=8080
HOST_PORT_METABASE=3000

# --- Airflow ------------------------------------------------------------------
# Shared by the Airflow services so tasks can authenticate to the API server.
AIRFLOW_JWT_SECRET=local-development-jwt-secret
# The sources live in simulated time, so there is no real "today" to schedule
# against. `manual` means runs are triggered for explicit logical dates; use a
# cron expression or @daily when the sources are real.
PIPELINE_SCHEDULE=manual
